DEBUG=false
CACHE_TTL_SECONDS=30
SCREENER_CACHE_TTL_SECONDS=300
SCREENER_INCLUDE_NEWS=false
# Optional: Add NewsAPI key for richer news (https://newsapi.org)
NEWS_API_KEY=
# Required for AI news summarization (https://console.anthropic.com)
ANTHROPIC_API_KEY=

# Telegram signal notifications
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
SIGNAL_NOTIFICATIONS_ENABLED=false
SIGNAL_POLL_INTERVAL_SECONDS=300
SIGNAL_COOLDOWN_MINUTES=30
SIGNAL_DEDUPE_TTL_HOURS=720
SIGNAL_MIN_SCORE=70
SIGNAL_MIN_RISK_REWARD=1.2
SIGNAL_MAX_ENTRY_DISTANCE_PCT=2
SIGNAL_MIN_TARGET_ROOM_PCT=1
SIGNAL_MARKETS=us,th,cn,gold,crypto

# Telegram pre-market market direction briefing
PREMARKET_NEWS_ENABLED=false
PREMARKET_NEWS_MARKETS=us,th,cn
PREMARKET_NEWS_MINUTES_BEFORE_OPEN=45
PREMARKET_NEWS_WINDOW_MINUTES=30
PREMARKET_NEWS_DEDUPE_TTL_HOURS=36

SNACK_TRADE_ENABLED=true
SNACK_TRADE_MIN_SCORE=58
SNACK_TRADE_MIN_RISK_REWARD=1.0
SNACK_TRADE_MIN_VOLUME_RATIO=0.5
SNACK_TRADE_MAX_PER_MARKET=1
SNACK_TRADE_MAX_ENTRY_DISTANCE_PCT=8
SNACK_TRADE_MIN_TARGET_ROOM_PCT=1
